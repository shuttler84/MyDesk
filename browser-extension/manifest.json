{
  "manifest_version": 3,
  "name": "MyDesk 收藏助手",
  "version": "1.0.0",
  "description": "一键把当前网页收藏到本地 MyDesk。数据只发送到你本机的 MyDesk 应用，不经任何服务器。",
  "permissions": ["tabs", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "收藏到 MyDesk"
  },
  "options_page": "options.html",
  "icons": {
    "128": "icon128.png"
  }
}
